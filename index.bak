    <section class="AnimacaoComBurgao" id="AnimacaoComBurgao">


        <section class="conteinerScroll" aria-hidden="true">
            <!-- Decoração otimizada: SVG único com animações eficientes -->
            <div class="decoracao-orbita" aria-hidden="true">
                <svg class="orbita-svg" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
                    <!-- Raios sutis (gradiente cônico otimizado) -->
                    <defs>
                        <radialGradient id="raioGrad" cx="50%" cy="50%">
                            <stop offset="0%" stop-color="rgba(255,255,255,0.08)" />
                            <stop offset="100%" stop-color="transparent" />
                        </radialGradient>
                    </defs>
                    <!-- Raios usando padrão repetido mais eficiente -->
                    <g class="orbita-raios-svg">
                        <circle cx="500" cy="500" r="300" fill="url(#raioGrad)" opacity="0.3">
                            <animateTransform attributeName="transform" type="rotate" values="0 500 500;360 500 500"
                                dur="60s" repeatCount="indefinite" />
                        </circle>
                    </g>
                    <!-- Círculos orbitais otimizados -->
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="210" fill="none"
                        stroke="rgba(255,255,255,0.35)" stroke-width="1" stroke-dasharray="4 8">
                        <animateTransform attributeName="transform" type="rotate" values="0 500 500;360 500 500"
                            dur="30s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="140" fill="none"
                        stroke="rgba(255,255,255,0.2)" stroke-width="1" stroke-dasharray="3 6">
                        <animateTransform attributeName="transform" type="rotate" values="360 500 500;0 500 500"
                            dur="45s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="90" fill="none"
                        stroke="rgba(255,255,255,0.25)" stroke-width="1" stroke-dasharray="2 5">
                        <animateTransform attributeName="transform" type="rotate" values="360 500 500;0 500 500"
                            dur="25s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="290" fill="none"
                        stroke="rgba(255,255,255,0.28)" stroke-width="1" stroke-dasharray="5 10">
                        <animateTransform attributeName="transform" type="rotate" values="0 500 500;360 500 500"
                            dur="38s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="250" fill="none"
                        stroke="rgba(255,255,255,0.3)" stroke-width="3" stroke-dasharray="6 12">
                        <animateTransform attributeName="transform" type="rotate" values="0 500 500;360 500 500"
                            dur="35s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="390" fill="none"
                        stroke="rgba(255,255,255,0.2)" stroke-width="1" stroke-dasharray="4 8">
                        <animateTransform attributeName="transform" type="rotate" values="360 500 500;0 500 500"
                            dur="50s" repeatCount="indefinite" />
                    </circle>
                    <circle class="orbita-circulo-svg" cx="500" cy="500" r="340" fill="none"
                        stroke="rgba(255,255,255,0.18)" stroke-width="2">
                        <animateTransform attributeName="transform" type="rotate" values="360 500 500;0 500 500"
                            dur="42s" repeatCount="indefinite" />
                    </circle>
                    <ellipse class="orbita-circulo-svg" cx="500" cy="500" rx="450" ry="375" fill="none"
                        stroke="rgba(255,255,255,0.15)" stroke-width="2" stroke-dasharray="5 10">
                        <animateTransform attributeName="transform" type="rotate" values="0 500 500;360 500 500"
                            dur="55s" repeatCount="indefinite" />
                    </ellipse>
                </svg>
            </div>
            <h1 class="h1-scroll-reveal">
                <span class="word" style="--word-index: 0">os</span>
                <span class="word" style="--word-index: 1">mais</span>
