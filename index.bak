<script src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>


<script>
    const lenis = new Lenis({
        duration: 1.3, // quanto maior, mais suave
        smoothWheel: true
    });

    const sectionAnim = document.querySelector('.AnimacaoComBurgao');
    const h1Reveal = document.querySelector('.h1-scroll-reveal');
    const sectionGrandao = document.getElementById('grandao-bisteca');
    var snapArmed = true;
    var snappingNow = false;
    const TOTAL_SLIDES = 5;
    var lastScrollY = -1;
    var lastUpdate = 0;
    var throttleMs = 50;

    function updateScrollReveal() {
        if (!sectionAnim || !h1Reveal) return;
        var rect = sectionAnim.getBoundingClientRect();
        var sectionHeight = sectionAnim.offsetHeight;
        var vh = window.innerHeight;
        var rawProgress = (vh - rect.top + vh * 0.3) / (vh + sectionHeight);
        var progress = Math.min(1, Math.max(0, rawProgress * 1.2));
        h1Reveal.style.setProperty('--scroll-progress', progress);
    }

    function updateGrandaoSlide() {
        if (!sectionGrandao) return;
        var rect = sectionGrandao.getBoundingClientRect();
        var sectionHeight = sectionGrandao.offsetHeight;
        var vh = window.innerHeight;
        var progress = Math.max(0, Math.min(1, (vh - rect.top) / (vh + sectionHeight)));
        var index = Math.min(TOTAL_SLIDES - 1, Math.floor(progress * TOTAL_SLIDES));
        sectionGrandao.classList.remove('slide-0', 'slide-1', 'slide-2', 'slide-3', 'slide-4');
        sectionGrandao.classList.add('slide-' + index);
        var bar = document.getElementById('grandao-progress-bar');
        if (bar) bar.style.width = (progress * 100) + '%';
    }

    function raf(time) {
        lenis.raf(time);
        var y = window.scrollY || document.documentElement.scrollTop;
        if (y !== lastScrollY) {
            lastScrollY = y;
            if (time - lastUpdate > throttleMs || lastUpdate === 0) {
                lastUpdate = time;
                updateScrollReveal();
                updateGrandaoSlide();

            }
        }
        requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
    window.addEventListener('resize', function () {
        updateScrollReveal();
        updateGrandaoSlide();
    });


    // Sistema de expansão do painel crypto-forno
    const cryptoLayout = document.querySelector('.crypto-layout');
    const expandButton = document.querySelector('.crypto-hero-button');
    const collapseButton = document.querySelector('.crypto-forno-collapse-button');

    function togglePanel() {
        if (!cryptoLayout) return;
        cryptoLayout.classList.toggle('expanded');
    }

    if (expandButton) {
        expandButton.addEventListener('click', function (e) {
            e.stopPropagation();
            togglePanel();
        });
    }

    if (collapseButton) {
        collapseButton.addEventListener('click', function (e) {
            e.stopPropagation();
            togglePanel();
        });
    }

    document.getElementById("venhaVer").addEventListener("click", function () {
        console.log("iii")
        document.getElementById("AnimacaoComBurgao").scrollIntoView({
            behavior: "smooth"
        });
    });


</script>

</html>